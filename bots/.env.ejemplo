# Configuracion de un bot. Copiar a .env (gitignored) y correr:
#   cd bots && npm install && node --env-file=.env node_modules/.bin/tsx src/index.ts
# o, mas corto, exportando las variables y `npm run bot`.

# El servidor de wtfuck. En local, el de desarrollo.
WTFUCK_BASE=http://localhost:8300

# La cuenta del bot. Se registra sola la primera vez y reconecta despues.
WTFUCK_BOT_USUARIO=botprueba
WTFUCK_BOT_PASSWORD=pon-una-contrasena-larga
WTFUCK_BOT_ETIQUETA=bot de prueba
WTFUCK_BOT_NOMBRE=eco

# Nivel de hardware declarado. En el servidor de desarrollo SOFTWARE_DEV se
# acepta; en produccion no (ver docs/04-DEVICE-BINDING.md), ahi hay que decidir
# como se crea la cuenta del bot.
WTFUCK_BOT_NIVEL=SOFTWARE_DEV

# Cola de turnos: true para bots de herramienta (uno a la vez), false para un
# bot de charla.
WTFUCK_BOT_COLA=true
# Segundos sin actividad antes de soltar el turno.
WTFUCK_BOT_INACTIVIDAD_S=600
