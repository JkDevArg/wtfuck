# Copiar a `.env.produccion` y rellenar. ESE archivo no va al repo.
#
# Los secretos se generan, no se inventan:
#   openssl rand -base64 32
#
# Una clave pensada por una persona tiene la entropia de una persona, y estas
# no se escriben nunca a mano: se pegan una vez y se olvidan.

# --- dominios -------------------------------------------------------------
DOMINIO_API=api.ejemplo.com
DOMINIO_MEDIA=media.ejemplo.com

# --- contrasenas de la infraestructura ------------------------------------
DB_PASS=
REDIS_PASS=
MINIO_USER=wtfuck
MINIO_PASS=

# --- secretos del servidor ------------------------------------------------

# Firma lo que viaja por el bus entre instancias. Obligatorio si hay Redis: el
# servidor NO arranca el bus sin el, y falla cerrado a proposito. Por el bus
# viajan avisos que el cliente OBEDECE -`expulsado` lo saca de un grupo,
# `mensaje_retirado` le borra un mensaje-, asi que sin firma cualquiera que
# alcance el Redis se los inyecta.
WTFUCK_BUS_SECRETO=

# Pepper de los hashes de telefono.
#
# NO SE PUEDE ROTAR sin mas: cambiarlo invalida todos los hashes guardados, o
# sea que nadie se encuentra por telefono y nadie recupera su cuenta. Rotarlo
# es una migracion, no un cambio de variable. Ponerlo bien la primera vez.
WTFUCK_PEPPER_TELEFONO=

# El mismo valor que `static-auth-secret` en despliegue/turnserver.conf.
WTFUCK_TURN_SECRETO=
WTFUCK_TURN_URL=turn:CAMBIAR.ejemplo.com:3478?transport=udp

# --- almacen --------------------------------------------------------------
#
# Por la red interna de Docker: `minio` es el nombre del servicio. MinIO no
# publica ningun puerto al exterior; lo que el telefono alcanza es
# DOMINIO_MEDIA, que Caddy hace llegar aqui.
WTFUCK_S3_URL=http://almacen:9000

# Y este es el que VE EL TELEFONO. Son dos y no uno, por una razon que cuesta
# una tarde si se descubre sobre la marcha:
#
# La firma SigV4 de las URLs del almacen incluye el header `Host`. O sea que
# la URL firmada solo vale si se pide por ESE mismo host; reescribirlo despues
# la invalida y el almacen responde 403.
#
# Y los dos hosts no pueden ser el mismo: el servidor alcanza el almacen por
# la red interna de Docker (`almacen:9000`, un nombre que fuera no existe) y el
# telefono lo alcanza por el dominio publico con TLS.
#
# Con uno solo hay que elegir, y las dos elecciones rompen algo. Con el
# interno, el telefono recibe `http://almacen:9000/...` y NO HAY ADJUNTOS en
# produccion. Con el publico, el servidor no puede crear el bucket al arrancar
# hasta que el DNS y el certificado esten listos, y el certificado no existe
# hasta el primer arranque.
#
# En desarrollo se deja vacio: ahi los dos SON el mismo host.
WTFUCK_S3_PUBLICO=https://media.ejemplo.com

WTFUCK_S3_USER=wtfuck
WTFUCK_S3_PASS=

# --- GIF (opcional) -------------------------------------------------------
#
# Sin esto la pestana de GIFs se queda vacia y lo dice; todo lo demas anda.
# WTFUCK_GIPHY_KEY=

# --- SMS (opcional) -------------------------------------------------------
#
# Solo hace falta si se quiere verificacion por telefono. Cada peticion cuesta
# dinero de verdad: ver los limites por destino en Limites.kt.
# WTFUCK_SMS_URL=
# WTFUCK_SMS_TOKEN=
# WTFUCK_SMS_REMITENTE=

# --- retencion de registros (modulo AT) -----------------------------------
#
# Cuanto se conservan los datos personales del servidor. Las dos tienen valor
# por defecto y estan aqui para que se VEAN: una obligacion legal distinta
# —otro pais, otra politica de la institucion— se ajusta sin recompilar.
#
# Cero o menos APAGA el barrido; no borra nada.
#
# No son lo mismo y por eso no caducan juntas: un evento de seguridad sirve
# para reconocer un acceso raro y detectar abuso en curso, y a los meses ya no
# sirve para ninguna de las dos. Una auditoria es el rastro de una decision de
# moderacion, y una decision se discute mucho despues.
# WTFUCK_RETENCION_SEGURIDAD_DIAS=90
# WTFUCK_RETENCION_AUDITORIA_DIAS=365

# --- quien administra -----------------------------------------------------
#
# El username que queda de propietario al arrancar por primera vez. Sin esto
# no hay nadie que pueda entrar al panel.
WTFUCK_PROPIETARIO=

# --- push (opcional, ver docs/09-DESPLIEGUE.md) ---------------------------
#
# Sin esto un mensaje o una llamada con la app CERRADA no despiertan el
# telefono. Todo lo demas funciona.
# WTFUCK_FCM_PROYECTO=
# WTFUCK_FCM_EMAIL=
# WTFUCK_FCM_CLAVE=
# WTFUCK_FCM_REMITENTE=
# WTFUCK_FCM_API_KEY=
# WTFUCK_FCM_APP_ID=
