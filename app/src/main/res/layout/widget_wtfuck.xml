<?xml version="1.0" encoding="utf-8"?>
<!-- Ver `WidgetWtfuck`: un numero, nunca nombres ni mensajes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#5EEAD4"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_nada"
            android:textColor="#E6EDED"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_nota"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/atajo_nota_corto"
        android:src="@drawable/ic_atajo_nota" />
</LinearLayout>
