<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Para ofrecer, desde Ajustes > Notificaciones, quitar la optimizacion de
      bateria con un toque. Sin esto, en muchos telefonos el aviso con la app
      cerrada se retrasa o se corta con la pantalla apagada. Play restringe
      este permiso a ciertas categorias; la app se distribuye por fuera.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Para poder ofrecer la actualizacion sin mandar a nadie al navegador.

      El APK se reparte fuera de una tienda, asi que nadie avisa de que hay
      algo nuevo: quien lo instalo se queda en esa version hasta que vuelve a
      la pagina por su cuenta, o sea, casi nunca.

      Esto NO instala nada en silencio — Android no se lo permite a una app
      normal, hace falta ser device owner o app de sistema. Lo que permite es
      que la descarga ocurra en segundo plano y que quede UN toque en el
      dialogo del sistema, en vez de bajar con el navegador, buscar el archivo
      y volver a pelearse con el permiso de origenes desconocidos.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Notas de voz y llamadas. Se pide en el momento, no al abrir la app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Modulo K: videollamadas. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Cambiar a altavoz durante una llamada. No es peligroso y no se pide. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Modulo M. Se usa UNA vez, cuando la persona toca "compartir ubicacion",
      y nunca en segundo plano: no se pide ACCESS_BACKGROUND_LOCATION porque
      esta app no sigue a nadie. Las dos variantes se declaran para que quien
      solo conceda la aproximada pueda compartir igual.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      Modulo AM. Compartir en tiempo real necesita un servicio en primer plano
      de tipo `location`, y desde Android 14 cada tipo tiene su propio permiso.

      Sigue SIN pedirse ACCESS_BACKGROUND_LOCATION, y la diferencia importa:
      un servicio en primer plano arrancado con la app delante -la persona
      toco el boton- puede leer la posicion mientras corre y con su
      notificacion a la vista. Lo que el permiso de fondo permitiria es leerla
      sin que nadie haya pedido nada, y eso esta app sigue sin hacerlo.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- K.8: la llamada vive en un servicio en primer plano. Sin esto una
         llamada se corta al salir de la app, porque Android mata procesos en
         segundo plano sin avisar. Los permisos POR TIPO son obligatorios desde
         Android 14: el sistema comprueba que la app tenga el permiso del tipo
         declarado en el momento de arrancar, y si no, no arranca. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- El modo cerca en primer plano mientras esta encendido. Ver `ServicioCerca`. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!--
      Modulo AV · Modo cine.

      Presentar la pantalla necesita su propio tipo de servicio en primer
      plano. Desde Android 14 no es opcional ni decorativo: el sistema exige
      que el servicio YA este corriendo con este tipo antes de entregar la
      proyeccion, y si no, lanza. Es a proposito — capturar la pantalla de
      alguien no puede pasar sin una notificacion visible que lo diga.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      Modulo AZ · Mensajeria sin internet, entre telefonos que estan cerca.

      `neverForLocation` en el escaneo importa: sin esa marca, Android exige
      ADEMAS el permiso de ubicacion, porque historicamente escanear Bluetooth
      servia para deducir donde esta alguien. Aqui no se usa para eso, y
      declararlo evita pedir un permiso de ubicacion que no hace falta — pedir
      de mas es como se ensena a la gente a aceptar sin leer.

      Las dos de abajo son para Android 11 y anteriores, donde estos permisos
      todavia no estaban separados.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Que una llamada entrante se vea con el telefono bloqueado. Android 14
         lo reserva para apps de llamadas y alarmas: esta es una de llamadas. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- La camara NO es obligatoria: sin ella la app sirve igual para audio y
         para mensajes, y declararla `required` la sacaria de la tienda para
         cualquier aparato sin camara. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".WtfuckApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_extraccion"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wtfuck"
        android:networkSecurityConfig="@xml/seguridad_de_red">

        <!--
            `exported=false`: lo arranca solo esta app. Y NO es "stopWithTask"
            por defecto sin decirlo: la llamada tiene que sobrevivir a que se
            cierre la Activity, que es el motivo entero del servicio.
        -->
        <!--
          Modulo N. El servicio que recibe el aviso de que hay algo que bajar.
          `exported="false"` y sin permiso propio: solo lo invoca el servicio de
          mensajeria del sistema, que usa su propio permiso firmado.
        -->
        <service
            android:name=".datos.ServicioPush"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Responder y marcar como leido desde la notificacion. Sin exportar:
          solo lo invocan los PendingIntent explicitos que arma la propia app.
        -->
        <receiver
            android:name=".datos.ReceptorAccionNotificacion"
            android:exported="false" />

        <!-- La alarma de los mensajes programados. Ver `Programados`. -->
        <receiver
            android:name=".datos.Programados$Receptor"
            android:exported="false" />

        <!--
          El modo cerca mientras esta encendido. `connectedDevice` es el tipo
          de un enlace con otro aparato; `stopWithTask="false"` para que cerrar
          la app desde recientes no corte a quien esta hablando por aqui.
        -->
        <service
            android:name=".datos.ServicioCerca"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <service
            android:name=".datos.ServicioLlamadaFg"
            android:exported="false"
            android:foregroundServiceType="microphone|camera|mediaProjection"
            android:stopWithTask="false" />

        <!--
          Modulo AM. Compartir la ubicacion en tiempo real.

          `stopWithTask="false"` porque el compartido tiene que sobrevivir a
          cerrar la app: el caso normal es "comparto mientras voy" y nadie deja
          la pantalla abierta durante ocho horas.

          El tipo `location` es obligatorio desde Android 14 y el sistema
          comprueba el permiso EN ESE MOMENTO: declarar el tipo equivocado -o
          arrancar sin permiso- no es un aviso, es una excepcion.
        -->
        <service
            android:name=".datos.ServicioUbicacionViva"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!--
          singleTop: con "standard", un enlace IGUAL al que arranco la app
          (wtfuck://c/...) no se entrega -Android solo trae la tarea al
          frente- y tocarlo otra vez no hacia nada. singleTop lo entrega
          siempre a la instancia que ya esta arriba.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Wtfuck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Recibir lo que se comparte desde otras apps. Ver `Pedidos`, que
              ademas solo acepta content:// de OTRAS apps.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- El enlace de contacto de alguien: wtfuck://c/<codigo>. Lo abre el
                 boton de la pagina del servidor. Ver `EnlaceDeContacto`. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wtfuck" android:host="c" />
            </intent-filter>

            <!-- Atajo fijo y destino de compartir. Ver `Atajos`. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/atajos" />
        </activity>

        <!-- El widget. Ver `WidgetWtfuck`: un numero, nunca nombres. -->
        <receiver
            android:name=".datos.WidgetWtfuck"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wtfuck" />
        </receiver>

        <!--
            Para abrir un adjunto con otra app.

            Desde Android 7 pasar un file:// a otra aplicacion lanza
            FileUriExposedException. El proveedor entrega un content:// con
            permiso de lectura acotado a ese archivo y a ese intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>
</manifest>
