# Secretos reales del entorno local.
#
# Copiá este archivo a `.env` y poné los valores. `.env` está en .gitignore y
# NO se commitea: una clave que entra al historial de git sigue ahí aunque
# después se borre el archivo.
#
# Los valores de desarrollo que no protegen nada —el secreto del bus, el pepper
# de pruebas, el TURN local— siguen estando a la vista en
# `pruebas/arrancar-servidor.ps1`, y eso es a propósito. Aquí van sólo los que
# sí protegen algo.
#
# Una variable que ya esté en el entorno gana sobre este archivo, así que en
# producción no hace falta: las inyecta el sistema de despliegue.
# Ver docs/09-DESPLIEGUE.md.

# Buscador de GIFs. Sin ella, la búsqueda responde que no está configurada en
# vez de fallar. La app nunca la ve: el servidor hace de intermediario.
WTFUCK_GIPHY_KEY=

# Push (módulo N.1). El camino entero está construido y probado contra un FCM
# de mentira; falta que Google acepte la firma.
WTFUCK_FCM_PROYECTO=
WTFUCK_FCM_EMAIL=
WTFUCK_FCM_CLAVE=
WTFUCK_FCM_APP_ID=
WTFUCK_FCM_API_KEY=
WTFUCK_FCM_REMITENTE=

# Web Push de la version web. `arrancar-servidor.ps1` genera unas de desarrollo
# en %TEMP% si no estan aqui; ver `node despliegue/generar-vapid.mjs`.
WTFUCK_VAPID_PUBLICA=
WTFUCK_VAPID_PRIVADA=
WTFUCK_VAPID_CONTACTO=
