# Compilacion
build/
.gradle/
*.apk
*.aab
local.properties

# Android Studio / IDE
.idea/
*.iml
.kotlin/

# Secretos y entorno local
*.pem
.env
# El de produccion lleva secretos de verdad. `.env` a secas NO lo tapa: un
# patron sin comodin coincide con ese nombre exacto y con ningun otro.
.env.produccion
# Los volcados de la base. Son el historial de todo el mundo en claro.
/copias/

# Salidas de pruebas
app/build/
server/build/
protocol/build/
/**/tmp[0-9a-z_]*

# La clave de firma de la app. Quien la tenga puede publicar una actualizacion
# que los telefonos aceptan como legitima, y NO se puede rotar.
keystore.properties
*.jks
*.keystore

# Las capturas de evidencia se quedan en local: llevan conversaciones de prueba
# con nombres de usuario reales, y este repositorio es publico.
docs/evidencias/**/*.png

# Credenciales del almacen, generadas por despliegue/preparar.sh
despliegue/s3.json

# Lo que genera despliegue/publicar-apk.sh: el APK pesa 90 MB y se
# reconstruye en cada version. No va a git.
despliegue/descarga/

# Config de despliegue: lleva host del VPS y rutas propias.
despliegue/despliegue.conf

# Firebase: no se usa el plugin google-services; la config va por el servidor en runtime.
google-services.json
